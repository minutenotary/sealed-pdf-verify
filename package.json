{
  "name": "sealed-pdf-verify",
  "version": "0.1.0",
  "description": "Offline, independent verifier for PDFs sealed by minutenotary.ca: SHA-256 digest, detached ECDSA P-256 signature, RFC 3161 timestamp and append-only ledger entry.",
  "keywords": [
    "pdf",
    "verify",
    "verification",
    "digital-signature",
    "ecdsa",
    "p-256",
    "rfc3161",
    "timestamp",
    "hash-chain",
    "offline"
  ],
  "homepage": "https://minutenotary.ca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minutenotary/sealed-pdf-verify.git"
  },
  "bugs": {
    "url": "https://github.com/minutenotary/sealed-pdf-verify/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sealed-pdf-verify": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tsa-roots",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:web",
    "build:lib": "tsup",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run check:brand && npm run check:roots && npm run lint && npm run typecheck && npm test && npm run build && npm run check:pack && npm run check:web && node scripts/smoke-dist.mjs",
    "check:brand": "node scripts/check-no-brand.mjs",
    "check:roots": "node scripts/sync-tsa-roots.mjs --check",
    "check:pack": "publint && attw --pack . --profile node16",
    "check:web": "node scripts/check-web-offline.mjs",
    "sync:roots": "node scripts/sync-tsa-roots.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@peculiar/asn1-cms": "3.0.0",
    "@peculiar/asn1-ecc": "3.0.0",
    "@peculiar/asn1-schema": "3.0.0",
    "@peculiar/asn1-tsp": "3.0.0",
    "@peculiar/asn1-x509": "3.0.0",
    "asn1js": "4.0.0",
    "fflate": "0.8.3",
    "pkijs": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  }
}
